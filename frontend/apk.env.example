# Public API origin embedded in the APK. Do not append /api.
VITE_API_ORIGIN=https://foodcalorie.gakiwoo.com

# Release signing secrets: configure in the shell or an untracked Gradle properties file.
FC_RELEASE_STORE_FILE=C:/path/to/release.keystore
FC_RELEASE_STORE_PASSWORD=replace-me
FC_RELEASE_KEY_ALIAS=replace-me
FC_RELEASE_KEY_PASSWORD=replace-me
