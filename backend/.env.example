# 食刻后端环境变量示例
# 复制为 .env 后填写真实值

# ── 服务 ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── 数据库（部署时与 gakiwoo-api 指向同一 SQLite 文件，共享 users 表）──
# 默认：./data/foodcalorie.db（本机开发）
# 生产（示例，与 gakiwoo-api 一致）：/var/lib/gakiwoo/gakiwoo.db
DB_PATH=./data/foodcalorie.db

# ── 认证（必须与 gakiwoo-api 的 JWT_SECRET 完全一致，保证 token 互通）──
# 部署时从 gakiwoo-api 的 .env 复制同一值
JWT_SECRET=please-set-same-secret-as-gakiwoo-api

# ── CORS 白名单（逗号分隔）──
# 生产环境必填；APK 默认 Origin 通常为 capacitor://localhost。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI 拍照识别（Kimi/Moonshot 视觉模型；不配置则降级为食物库候选推荐）──
# 申请：https://platform.moonshot.cn （创建 API Key）
MOONSHOT_API_KEY=
# 可选覆盖（默认中国站 + moonshot-v1-8k-vision-preview）
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_VISION_MODEL=moonshot-v1-8k-vision-preview

# 模型结果默认不写入公共食物库。仅在建立审核/质量监控后显式开启。
AI_BACKFILL_ENABLED=false

# 私有上传目录；图片只能通过鉴权 API 读取，禁止由 nginx 直接 alias 暴露。
# UPLOAD_DIR=/var/www/foodcalorie-api/uploads
